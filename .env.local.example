  # LLM（OpenAI-compatible；用百炼就用 compatible-mode）
  LLM_API_KEY=
  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
  LLM_MODEL_NAME=qwen3-max

  # LLM 联网查询兜底配置（用于 Step2 真实人设验证，默认复用阿里百炼兼容模式）
  LLM_WEB_SEARCH_API_KEY=
  LLM_WEB_SEARCH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
  LLM_WEB_SEARCH_MODEL=qwen3-max
  LLM_WEB_SEARCH_STRATEGY=max
  LLM_WEB_SEARCH_VALIDATE_LINKS=true
  REAL_ENTITY_BATCH_SIZE=30

  # 联网搜索能力选择：默认走阿里百炼 websearch；需要博查时再显式开启。
  USE_BOCHA_WEB_SEARCH=false
  WEB_SEARCH_PROVIDER=bailian

  # GRAPHITI_LLM_MODEL：Graphiti 做实体/关系抽取时使用的聊天模型。
  # 当前示例 qwen-plus 走百炼兼容模式；更高质量可改为 qwen-max / qwen3-max（以百炼控制台可用模型为准）。
  GRAPHITI_LLM_MODEL=qwen-plus

  # GRAPHITI_EMBEDDING_MODEL：Graphiti 生成节点/边向量时使用的 embedding 模型名。
  # 默认使用百炼 text-embedding-v4；如果配置独立内网服务，可改成 Qwen3-Embedding-4B 等服务支持的模型名。
  GRAPHITI_EMBEDDING_MODEL=text-embedding-v4

  # Graphiti embedding 独立配置（可选）：留空时继续复用 LLM/OPENAI endpoint。
  # 接入内网 embedding-only 服务时只配置这里，不要改 OPENAI_BASE_URL，避免影响 Graphiti LLM 抽取。
  # GRAPHITI_EMBEDDING_API_KEY：独立 embedding 服务的 API Key；无鉴权内网服务可留空。
  GRAPHITI_EMBEDDING_API_KEY=
  # GRAPHITI_EMBEDDING_BASE_URL：独立 embedding 服务的 OpenAI-compatible base URL。
  # 示例：http://10.200.89.13:9997/v1；留空则继续使用 OPENAI_BASE_URL/LLM_BASE_URL。
  GRAPHITI_EMBEDDING_BASE_URL=
  # GRAPHITI_EMBEDDING_DIM：写入 Neo4j 的向量维度。
  # graphiti-core 默认写入 1024 维；Qwen3-Embedding-4B 实测返回 2560 维时应设置为 2560。
  GRAPHITI_EMBEDDING_DIM=1024
  # GRAPHITI_EMBEDDING_BATCH_SIZE：Graphiti 批量生成 embedding 时每次请求的最大文本条数。
  # 百炼 text-embedding-v4 建议 10；内网服务可按吞吐能力调大，例如 32。
  GRAPHITI_EMBEDDING_BATCH_SIZE=10

  # ===== 加速 LLM 配置（可选）=====
  # 用于图谱构建、Agent人设生成、模拟配置和报告生成等高并发 LLM 环节。
  # 如果不使用加速配置，请不要在 .env 中保留下面三个配置项。
  # LLM_BOOST_API_KEY：加速 LLM 服务的 API Key；配置为空或缺失时自动回退到默认 LLM。
  LLM_BOOST_API_KEY=
  # LLM_BOOST_BASE_URL：加速 LLM 的 OpenAI 兼容接口地址，例如 DashScope compatible-mode/v1。
  LLM_BOOST_BASE_URL=https://api.deepseek.com/v1
  # LLM_BOOST_MODEL_NAME：加速 LLM 的模型名称，用于并发生成、抽取和报告写作。
  LLM_BOOST_MODEL_NAME=deepseek-chat

  # ===== 并发加速配置（可选）=====
  # Graphiti 本地默认使用单条 episode 并发写入，避开 bulk 历史上下文导致的尾批变慢。
  # ONTOLOGY_MAX_TEXT_LENGTH_FOR_LLM：本体生成传给 LLM 的最大正文长度；只影响 01 本体分析，不影响 02 图谱构建原文。
  ONTOLOGY_MAX_TEXT_LENGTH_FOR_LLM=30000
  # GRAPH_BUILD_BATCH_SIZE：图谱构建时每批提交的文本块数量；越大调度次数越少，但单批失败重试成本更高。
  GRAPH_BUILD_BATCH_SIZE=3
  # GRAPH_BUILD_CONCURRENCY：图谱构建批次并发数；额度较紧时可降为 1，减少 429 重试。
  GRAPH_BUILD_CONCURRENCY=2
  # GRAPH_BUILD_BATCH_DELAY_SECONDS：图谱批次提交后的节流等待秒数；遇到 LLM/Neo4j 限流或写入压力时可调大。
  GRAPH_BUILD_BATCH_DELAY_SECONDS=0
  # GRAPH_BUILD_DUAL_LLM_ENABLED：Graphiti 图谱构建时是否让 LLM_BASE 与 LLM_BOOST 分摊实体/关系抽取；仅 boost 三项完整且非占位 key 时生效。
  GRAPH_BUILD_DUAL_LLM_ENABLED=true
  # GRAPH_BUILD_LLM_BASE_WEIGHT / GRAPH_BUILD_LLM_BOOST_WEIGHT：双模型分摊权重；数值越大分到的批次越多，程序会限制到安全范围。
  GRAPH_BUILD_LLM_BASE_WEIGHT=1
  GRAPH_BUILD_LLM_BOOST_WEIGHT=1
  # GRAPH_BUILD_LLM_ROUTE_RETRY_ENABLED：某个模型路由超时或失败时，是否切换另一路由重试该批次一次。
  GRAPH_BUILD_LLM_ROUTE_RETRY_ENABLED=true
  # GRAPHITI_EPISODE_BATCH_SIZE：Graphiti bulk 模式下单次写入 episode 数；默认禁用 bulk 时实际会压到 1。
  GRAPHITI_EPISODE_BATCH_SIZE=1
  # GRAPHITI_INGEST_CONCURRENCY：Graphiti 批次提交并发数；稳定优先可降为 1。
  GRAPHITI_INGEST_CONCURRENCY=2
  # GRAPHITI_USE_BULK_INGEST：是否启用 Graphiti bulk ingestion；默认关闭，避免 retrieve_previous_episodes_bulk 和批量 resolve 拖慢尾批。
  GRAPHITI_USE_BULK_INGEST=false
  # GRAPHITI_OPERATION_TIMEOUT_SECONDS：Graphiti 单次异步操作最长等待秒数，避免图谱写入或查询长时间卡死。
  GRAPHITI_OPERATION_TIMEOUT_SECONDS=900
  # GRAPHITI_RATE_LIMIT_MAX_RETRIES：Graphiti 调用 LLM/Embedding 触发限流时的最大重试次数。
  GRAPHITI_RATE_LIMIT_MAX_RETRIES=3
  # GRAPHITI_RATE_LIMIT_RETRY_SECONDS：Graphiti 限流重试的基础等待秒数；多次重试会按次数递增等待。
  GRAPHITI_RATE_LIMIT_RETRY_SECONDS=20
  # GRAPHITI_LLM_CONCURRENCY：Graphiti 内部 LLM 抽取并发数；额度紧张时可降为 1。
  GRAPHITI_LLM_CONCURRENCY=2
  # GRAPHITI_LLM_MIN_INTERVAL_SECONDS：Graphiti LLM 请求最小间隔；遇到 429 时可调大到 1-3 秒。
  GRAPHITI_LLM_MIN_INTERVAL_SECONDS=0.5
  # GRAPHITI_LLM_REQUEST_TIMEOUT_SECONDS：Graphiti 单次 LLM 请求超时，避免上游请求悬挂拖慢整批写入。
  GRAPHITI_LLM_REQUEST_TIMEOUT_SECONDS=120
  # GRAPHITI_LLM_MAX_TOKENS：Graphiti 每次抽取请求的输出上限；过高会放大慢模型等待时间。
  GRAPHITI_LLM_MAX_TOKENS=4096
  # GRAPHITI_LLM_SMALL_MODEL：Graphiti resolve/属性抽取等小任务模型；留空时复用主模型。
  GRAPHITI_LLM_SMALL_MODEL=
  # GRAPHITI_LLM_TEMPERATURE：Graphiti 抽取温度，建议保持 0 以减少 JSON 重试。
  GRAPHITI_LLM_TEMPERATURE=0
  # GRAPHITI_EMBEDDING_REQUEST_TIMEOUT_SECONDS：Graphiti 单次 embedding 请求超时。
  GRAPHITI_EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
  # GRAPHITI_USE_PREVIOUS_EPISODE_CONTEXT：是否把历史文本块注入后续抽取提示词；默认关闭以避免尾批越来越慢。
  GRAPHITI_USE_PREVIOUS_EPISODE_CONTEXT=false
  # GRAPH_EXTRACTION_CONTEXT_MAX_SUMMARY_CHARS：每个图谱文本块附加的事件摘要最大长度，过大将增加 LLM 抽取耗时。
  GRAPH_EXTRACTION_CONTEXT_MAX_SUMMARY_CHARS=600
  # GRAPH_EXTRACTION_CONTEXT_MAX_ENTITY_HINTS：每个图谱文本块附加的实体提示数量。
  GRAPH_EXTRACTION_CONTEXT_MAX_ENTITY_HINTS=20
  # GRAPH_EXTRACTION_CONTEXT_MAX_HINT_CHARS：每个图谱文本块附加的实体提示总长度。
  GRAPH_EXTRACTION_CONTEXT_MAX_HINT_CHARS=400
  # GRAPHITI_EMBEDDING_MIN_INTERVAL_SECONDS：Graphiti embedding 请求之间的最小间隔秒数。
  # 适当节流可减少 429；内网服务可从 0.1 开始，百炼额度紧张时可设 0.5-1。
  GRAPHITI_EMBEDDING_MIN_INTERVAL_SECONDS=0.5
  # GRAPH_MEMORY_STOP_TIMEOUT_SECONDS：停止或重跑模拟时等待图谱记忆后台线程收尾的秒数，避免旧任务阻塞新流程。
  GRAPH_MEMORY_STOP_TIMEOUT_SECONDS=3
  # REAL_ENTITY_RESOLVE_CONCURRENCY：真实实体识别、去重和关联校验的并发数。
  REAL_ENTITY_RESOLVE_CONCURRENCY=3
  # PROFILE_GENERATION_CONCURRENCY：Agent 人设生成的并发数，主要影响 Step2 环境搭建速度。
  PROFILE_GENERATION_CONCURRENCY=5
  # SIMULATION_CONFIG_CONCURRENCY：Agent 活动配置和模拟配置生成的并发数，主要影响 Step2 准备阶段速度。
  SIMULATION_CONFIG_CONCURRENCY=3
  # REPORT_TOOL_CONCURRENCY：Step4 报告生成时检索/图谱查询等工具调用的并发数。
  REPORT_TOOL_CONCURRENCY=3
  # REPORT_SECTION_CONCURRENCY：Step4 报告章节并发写作数量；过高可能触发 LLM 限流或造成章节风格不稳。
  REPORT_SECTION_CONCURRENCY=2

  # 本地图谱后端
  ZEP_BACKEND=graphiti
  NEO4J_URI=bolt://localhost:7687
  # 使用仓库内置 docker-compose 的 Neo4j 服务时，用户名固定为 neo4j，不要改成自定义用户。
  NEO4J_USER=neo4j
  # Neo4j 初始密码至少 8 位；建议只使用字母、数字、下划线、连字符和点，避免 Compose 解析特殊字符。
  NEO4J_PASSWORD=password

  # 博查 Web Search API（USE_BOCHA_WEB_SEARCH=true 时必需）
  BOCHA_API_KEY=
  BOCHA_BASE_URL=https://api.bochaai.com/v1
  BOCHA_WEB_SEARCH_ENDPOINT=/web-search
  BOCHA_WEB_SEARCH_TIMEOUT=30
  BOCHA_WEB_SEARCH_MAX_RESULTS=8
  BOCHA_WEB_SEARCH_FRESHNESS=twoMonths
  BOCHA_WEB_SEARCH_RECENT_DAYS=60
  BOCHA_VALIDATE_LINKS=true
  BOCHA_LINK_CHECK_TIMEOUT=5
  BOCHA_LINK_CHECK_MAX_BYTES=16384
